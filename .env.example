# LLM provider (OpenRouter is OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# Alternatively, use a DeepSeek API key directly by REPLACING the 3 values above:
# OPENROUTER_API_KEY=<your DeepSeek API key>  # factory keeps the original lab variable name
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com

# SQLite database path (optional - defaults to ./hitl_audit.db in CWD)
# HITL_DB_PATH=hitl_audit.db

# GitHub Personal Access Token - REQUIRED.
# Create a classic PAT at https://github.com/settings/tokens/new
# Select public_repo for the public VinUni-AI20k/PR-Demo repository.
GITHUB_TOKEN=

# Reviewer username recorded on human-in-the-loop audit events.
GITHUB_USER=VuDuyDiepAI
